// Compatibility Boilerplate v1.0.0
// Usage:
// - do not modify main_screen_content, long_form, custom_form and any form which was modified by another addon
// - each addon can only claim one action_form_x and modal_form_x
{
  "namespace": "server_form",
  
  "main_screen_content": { "size": ["100%","100%"] },

  "long_form": {
    "size": ["100%", "100%"],
    "controls": [
      { "default@common_dialogs.main_panel_no_buttons": {
        "$title_panel": "common_dialogs.standard_title_label",
        "$title_size": ["100% - 15px", 10],
        "$title_max_size": ["100% - 15px", 10],
        "size": [225, 200],
        "$text_name": "#title_text",
        "$title_text_binding_type": "none",
        "$child_control": "server_form.long_form_panel",
        "layer": 2,

        "bindings": [
          { "binding_name": "#form_title" },
          {
            "binding_type": "view",
            "source_property_name": "(#title_text = (#title_text - '§custom-form§'))",
            "target_property_name": "#visible"
          }
        ]
      }},
      { "slot_1@server_form.action_form_1": {}},
      { "slot_2@server_form.action_form_2": {}},
      { "slot_3@server_form.action_form_3": {}},
      { "slot_4@server_form.action_form_4": {}},
      { "slot_5@server_form.action_form_5": {}},
      { "slot_6@server_form.action_form_6": {}},
      { "slot_7@server_form.action_form_7": {}},
      { "slot_8@server_form.action_form_8": {}},
      { "slot_9@server_form.action_form_9": {}}
    ]
  },
  "custom_form": {
    "size": ["100%", "100%"],
    "controls": [
      { "custom_form@common_dialogs.main_panel_no_buttons": {
        "$title_panel": "common_dialogs.standard_title_label",
        "$title_size": ["100% - 15px", 10],
        "$title_max_size": ["100% - 15px", 10],
        "size": [225, 200],
        "$text_name": "#title_text",
        "$title_text_binding_type": "none",
        "$child_control": "server_form.custom_form_panel",
        "layer": 2,

        "bindings": [
          { "binding_name": "#form_title" },
          {
            "binding_type": "view",
            "source_property_name": "(#title_text = (#title_text - '§custom-form§'))",
            "target_property_name": "#visible"
          }
        ]
      }},
      { "slot_1@server_form.modal_form_1": {}},
      { "slot_2@server_form.modal_form_2": {}},
      { "slot_3@server_form.modal_form_3": {}},
      { "slot_4@server_form.modal_form_4": {}},
      { "slot_5@server_form.modal_form_5": {}},
      { "slot_6@server_form.modal_form_6": {}},
      { "slot_7@server_form.modal_form_7": {}},
      { "slot_8@server_form.modal_form_8": {}},
      { "slot_9@server_form.modal_form_9": {}}
    ]
  },
  "action_form_1@skybedrock_forms.action_forms": { "type": "panel" }, // Used By Skybedrock
  "action_form_2": { "type": "panel" }, // Used By QuestBook
  "action_form_3": { "type": "panel" },
  "action_form_4": { "type": "panel" },
  "action_form_5": { "type": "panel" },
  "action_form_6": { "type": "panel" },
  "action_form_7": { "type": "panel" },
  "action_form_8": { "type": "panel" },
  "action_form_9": { "type": "panel" },

  "modal_form_1@skybedrock_forms.modal_forms": { "type": "panel" }, // Used By Skybedrock
  "modal_form_2": { "type": "panel" },
  "modal_form_3": { "type": "panel" },
  "modal_form_4": { "type": "panel" },
  "modal_form_5": { "type": "panel" },
  "modal_form_6": { "type": "panel" },
  "modal_form_7": { "type": "panel" },
  "modal_form_8": { "type": "panel" },
  "modal_form_9": { "type": "panel" }
}