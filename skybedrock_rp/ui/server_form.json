{
  "namespace": "server_form",
  
  // Compatibility Boilerplate
  "main_screen_content": { "size": ["100%","100%"] },

  "long_form": {
    "size": ["100%", "100%"],
    "controls": [
      { "default@common_dialogs.main_panel_no_buttons": {
        "$title_panel": "common_dialogs.standard_title_label",
        "$title_size": ["100% - 15px", 10],
        "$title_max_size": ["100% - 15px", 10],
        "size": [225, 200],
        "$text_name": "#title_text",
        "$title_text_binding_type": "none",
        "$child_control": "server_form.long_form_panel",
        "layer": 2,

        "bindings": [
          { "binding_name": "#form_title" },
          {
            "binding_type": "view",
            "source_property_name": "(#title_text = (#title_text - '§custom-form§'))",
            "target_property_name": "#visible"
          }
        ]
      }},
      { "slot_1@server_form.addon_1_action_form": {}},
      { "slot_2@server_form.addon_2_action_form": {}},
      { "slot_3@server_form.addon_3_action_form": {}},
      { "slot_4@server_form.addon_4_action_form": {}},
      { "slot_5@server_form.addon_5_action_form": {}},
      { "slot_6@server_form.addon_6_action_form": {}},
      { "slot_7@server_form.addon_7_action_form": {}},
      { "slot_8@server_form.addon_8_action_form": {}},
      { "slot_9@server_form.addon_9_action_form": {}}
    ]
  },
  "custom_form": {
    "size": ["100%", "100%"],
    "controls": [
      { "custom_form@common_dialogs.main_panel_no_buttons": {
        "$title_panel": "common_dialogs.standard_title_label",
        "$title_size": ["100% - 15px", 10],
        "$title_max_size": ["100% - 15px", 10],
        "size": [225, 200],
        "$text_name": "#title_text",
        "$title_text_binding_type": "none",
        "$child_control": "server_form.custom_form_panel",
        "layer": 2,

        "bindings": [
          { "binding_name": "#form_title" },
          {
            "binding_type": "view",
            "source_property_name": "(#title_text = (#title_text - '§custom-form§'))",
            "target_property_name": "#visible"
          }
        ]
      }},
      { "slot_1@server_form.addon_1_modal_form": {}},
      { "slot_2@server_form.addon_2_modal_form": {}},
      { "slot_3@server_form.addon_3_modal_form": {}},
      { "slot_4@server_form.addon_4_modal_form": {}},
      { "slot_5@server_form.addon_5_modal_form": {}},
      { "slot_6@server_form.addon_6_modal_form": {}},
      { "slot_7@server_form.addon_7_modal_form": {}},
      { "slot_8@server_form.addon_8_modal_form": {}},
      { "slot_9@server_form.addon_9_modal_form": {}}
    ]
  },
  // "addon_1_action_form": { "type": "panel" }, // Used By Skybedrock
  "addon_2_action_form": { "type": "panel" }, // Used By QuestBook
  "addon_3_action_form": { "type": "panel" },
  "addon_4_action_form": { "type": "panel" },
  "addon_5_action_form": { "type": "panel" },
  "addon_6_action_form": { "type": "panel" },
  "addon_7_action_form": { "type": "panel" },
  "addon_8_action_form": { "type": "panel" },
  "addon_9_action_form": { "type": "panel" },

  // "addon_1_modal_form": { "type": "panel" }, // Used By Skybedrock
  "addon_2_modal_form": { "type": "panel" },
  "addon_3_modal_form": { "type": "panel" },
  "addon_4_modal_form": { "type": "panel" },
  "addon_5_modal_form": { "type": "panel" },
  "addon_6_modal_form": { "type": "panel" },
  "addon_7_modal_form": { "type": "panel" },
  "addon_8_modal_form": { "type": "panel" },
  "addon_9_modal_form": { "type": "panel" },
// ---

  // Skybedrock Content
  "addon_1_action_form": {
    "type": "panel",
    "$visible_when": [
      { "binding_name": "#form_title" },
      {
        "binding_type": "view",
        "source_property_name": "(not (#title_text = #title_text - $ui_tag))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      { "guidebook@guidebook.main_panel": {
        "bindings": "$visible_when",
        "$ui_tag": "§book_ui§"
      }},
      { "quests_form@quests.quests_menu": {
        "bindings": "$visible_when",
        "$ui_tag": "§quests_ui§"
      }},
      { "quest_screen@quests.quest_screen": {
        "bindings": "$visible_when",
        "$ui_tag": "§quest_screen§"
      }},
      { "world_map_form@maps.world_map_form": {
        "bindings": "$visible_when",
        "$ui_tag": "§map_ui§"
      }},

      { "skypedia": {
        "ignored": true, // Disabled because to performance issues
        "type": "collection_panel",
        "$ui_tag": "§skypedia§",
        
        "factory": {
          "name": "skypedia_factory",
          "control_name": "how_to_play.how_to_play_screen"
        },
        "bindings": [
          { "binding_name": "#form_title" },
          {
            "binding_type": "view",
            "source_property_name": "(not (#title_text = #title_text - $ui_tag) + 0)",
            "target_property_name": "#collection_length"
          }
        ]
      }}
    ]
  },

  "addon_1_modal_form" : {
    "type": "panel",
    "$visible_when": [
      { "binding_name": "#form_title" },
      {
        "binding_type": "view",
        "source_property_name": "(not (#title_text = #title_text - $ui_tag))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      { "guidebook@guidebook.main_panel": {
        "bindings": "$visible_when",
        "$ui_tag": "§skybedrock_settings§"
      }},
      { "waypoints@maps.manage_waypoint_screen": {
        "bindings": "$visible_when",
        "$ui_tag": "§waypoint-ui§"
      }}
    ]
  }
}